{
	"name": "tensquads",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "npm@11.19.1",
	"workspaces": [
		"apps/*",
		"packages/adapters",
		"packages/domain",
		"packages/kernel",
		"packages/seed",
		"packages/squadmates"
	],
	"scripts": {
		"dco:fix": "git rebase --signoff",
		"clean": "npm run clean --workspaces --if-present",
		"build": "npm run build --workspaces --if-present",
		"test": "node --experimental-strip-types --test scripts/test/*.test.mjs && node scripts/run-workspaces.mjs test",
		"fallow:audit": "fallow audit --changed-since origin/main",
		"preview:cloudflare": "npm run cf:preview -w @tensquads/web",
		"build:cloudflare": "npm run cf:build -w @tensquads/web",
		"deploy:cloudflare": "npm run cf:deploy -w @tensquads/web",
		"deploy:cloudflare:real": "node scripts/deploy-cloudflare-real.mjs",
		"real:secrets-check": "node scripts/real-secrets-check.mjs",
		"real:bootstrap": "node --experimental-strip-types scripts/real-bootstrap.mjs",
		"typegen:cloudflare": "npm run cf:typegen -w @tensquads/web",
		"preflight:native-deps": "node scripts/preflight-native-deps.mjs",
		"check": "npm run preflight:native-deps && biome check --error-on-warnings . && node scripts/check-file-length.mjs && node scripts/typecheck.mjs && node scripts/run-workspaces.mjs check",
		"fix": "npm run preflight:native-deps && biome check --write --error-on-warnings .",
		"prepare": "node scripts/prepare.mjs",
		"design:check": "node scripts/design-check.mjs",
		"design:inventory": "node scripts/design-inventory.mjs",
		"seed": "node --experimental-strip-types packages/seed/src/cli.ts",
		"e2e": "node scripts/e2e.mjs",
		"statechart:check": "node scripts/statechart-check.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "2.6.5",
		"@neondatabase/serverless": "1.2.0",
		"@playwright/test": "^1.64.1",
		"@tensquads/adapters": "*",
		"@tensquads/domain": "*",
		"@tensquads/kernel": "*",
		"@types/node": "^24.19.2",
		"esbuild": "^0.28.2",
		"fallow": "3.39.0",
		"husky": "^9.1.7",
		"miniflare": "5.20261023.1-beta",
		"pg-connection-string": "2.14.1",
		"typescript": "7.0.2",
		"yaml": "2.9.1"
	},
	"engines": {
		"node": "24.x"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261023.1": true,
		"fsevents@2.3.3": true
	}
}
